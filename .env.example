# Copy to `.env` and adjust. Never commit `.env`.
# `docker compose` requires this file (env_file) — fill values before `up`.
# Volumes must resolve outside the repository (NFR-9 / AD-3).

# Absolute host path for Postgres data (and future PDF volume root). Example:
#   FINANCE_HELPER_DATA=/Users/you/finance-helper
FINANCE_HELPER_DATA=

POSTGRES_USER=finance
POSTGRES_PASSWORD=finance_dev_change_me
POSTGRES_DB=finance_helper

# ui — server-side only (same-origin BFF at /api/* → api; avoid NEXT_PUBLIC_API_URL for auth)
# Compose derives DATABASE_URL from POSTGRES_* for the api service.
API_INTERNAL_URL=http://api:8000

# Auth session (AD-8) — api is the single cookie issuer; ui BFF forwards Set-Cookie.
# Opaque session token stored in Postgres; cookie is httpOnly.
SESSION_SECRET=replace_with_long_random_string
SESSION_COOKIE_NAME=fh_session
# Local Compose over HTTP: false. Homelab/prod behind HTTPS: true (see docker-compose.prod.yml).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# FR-4 off for Story 1.2 — signup is usable without email verification.
EMAIL_VERIFICATION_REQUIRED=false

# SMTP — used by later stories (password reset / invites); unused by signup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
