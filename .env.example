# Copy to `.env` and adjust. Never commit `.env`.
# `docker compose` requires this file (env_file) — fill values before `up`.
# Volumes must resolve outside the repository (NFR-9 / AD-3).

# Absolute host path for Postgres data (and future PDF volume root). Example:
#   FINANCE_HELPER_DATA=/Users/you/finance-helper
FINANCE_HELPER_DATA=

POSTGRES_USER=finance
POSTGRES_PASSWORD=finance_dev_change_me
POSTGRES_DB=finance_helper

# ui — server-side only (prefer same-origin / BFF later; avoid NEXT_PUBLIC_API_URL for auth)
# Compose derives DATABASE_URL from POSTGRES_* for the api service.
API_INTERNAL_URL=http://api:8000

# Placeholders for later stories (1.2+) — unused by health scaffold
SESSION_SECRET=replace_with_long_random_string
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
